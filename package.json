{
  "name": "bidderx",
  "version": "1.0.0",
  "description": "BidderX - Online Auction System",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node -e \"require('node:fs').rmSync('data',{recursive:true,force:true})\" && npm run db:seed"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.21.1"
  }
}
